module

public import NPComplete.CookLevin.ToThreeCNF.Writer

/-!
# Split-tail payload and writers

Long clauses are reduced by emitting linking triples until the remaining suffix
is short, then using a terminal writer. This module defines the encoded payload
and terminal and intermediate programs, and proves their state, frame, and cost
properties. The payload correspondence connects these RAM programs to the pure
width-reduction transformation.
-/

@[expose] public section

namespace NPComplete.CookLevin

open NPComplete.SAT
open NPComplete.RAMToTM
  (BitsFrom bitsFrom_append bitsFrom_writeReg bitsFrom_of_eq_on BitsAt bitsAt_of_frame finalizeOutputProg FinalizeRegsOk ctlCell ctlCell_eval)
open NPComplete.BoundedWhile
  (Program Store Expr eval_assign eval_seq writeReg writeReg_diff writeReg_same cost_seq
    cost_ifNZ cost_forN eval_ifNZ eval_forN loopEval loopEval_succ
    loopCost loopCost_le_of_body_le)
open NPComplete.BitEncoding (Bits encodeNat encodeList encodeNat_length)
/-! The pure payload generated by repeatedly applying one `splitTail` link.
This separates the list algebra from the RAM program and is the bridge used
by the eventual dynamic link loop.
-/

def splitTailPayload (base : ℕ) (carry : Literal) : List Literal → Bits
  | [] => encodeThreeClause ⟨carry, carry, carry⟩
  | [l] => encodeThreeClause ⟨carry, l, l⟩
  | [l1, l2] => encodeThreeClause ⟨carry, l1, l2⟩
  | l :: rest =>
      encodeThreeClause ⟨carry, l, Literal.pos base⟩ ++
        splitTailPayload (base + 1) (Literal.neg base) rest

lemma splitTailPayload_eq_encode
    (base : ℕ) (carry : Literal) (ls : List Literal) :
    splitTailPayload base carry ls =
      encodeThreeClausesPayload (splitTail base carry ls).1 := by
  induction ls generalizing base carry with
  | nil =>
      simp [splitTailPayload, splitTail, encodeThreeClausesPayload]
  | cons l rest ih =>
      cases rest with
      | nil =>
          simp [splitTailPayload, splitTail, encodeThreeClausesPayload]
      | cons l2 rest2 =>
          cases rest2 with
          | nil =>
              simp [splitTailPayload, splitTail, encodeThreeClausesPayload]
          | cons l3 rest3 =>
              simp [splitTailPayload, splitTail, encodeThreeClausesPayload,
                ih]

def literalPolarity : Literal → ℕ
  | .pos _ => 0
  | .neg _ => 1

lemma splitTailPayload_cons3
    (base : ℕ) (carry l l2 l3 : Literal) (rest : List Literal) :
    splitTailPayload base carry (l :: l2 :: l3 :: rest) =
      encodedThreeLiteralBits (literalPolarity carry) carry.var
        (literalPolarity l) l.var 0 base ++
        splitTailPayload (base + 1) (Literal.neg base) (l2 :: l3 :: rest) := by
  have hcarry : literalPolarity carry = 0 ∨ literalPolarity carry = 1 := by
    cases carry <;> simp [literalPolarity]
  have hl : literalPolarity l = 0 ∨ literalPolarity l = 1 := by
    cases l <;> simp [literalPolarity]
  have henc := encodedThreeLiteralBits_eq_encodeThreeClause
    (literalPolarity carry) carry.var (literalPolarity l) l.var 0 base
    hcarry hl (Or.inl rfl)
  have hcarryLit : literalOfPolarity (literalPolarity carry) carry.var = carry := by
    cases carry <;> rfl
  have hlit : literalOfPolarity (literalPolarity l) l.var = l := by
    cases l <;> rfl
  have hposLit : literalOfPolarity 0 base = Literal.pos base := by
    simp [literalOfPolarity]
  rw [hcarryLit, hlit, hposLit] at henc
  simpa [splitTailPayload] using henc.symm

/-! Runtime split-tail loop skeleton.  The remaining register is tested at
zero, one, and two; larger values take one recursive link.  A fixed `forN`
bound makes the while-free program terminate after the supplied tail bound.
-/

def splitTailEmitTerminalZeroProg
    (curJ tmpJ _cursorReg _polReg _varReg _doneReg remainingReg carryPolReg carryValReg
      _posPolReg _freshReg _bound : ℕ) : Program :=
  .seq
    (writerAppendThreeRegsProg curJ tmpJ carryPolReg carryValReg carryPolReg carryValReg
      carryPolReg carryValReg)
    (.assign remainingReg (.const 0))

def splitTailEmitTerminalOneProg
    (curJ tmpJ cursorReg _polReg _varReg doneReg remainingReg pol2Reg var2Reg carryPolReg carryValReg
      _posPolReg _freshReg bound : ℕ) : Program :=
  .seq
    (decodeLiteralValueProgram cursorReg pol2Reg var2Reg doneReg bound)
    (.seq
      (writerAppendThreeRegsProg curJ tmpJ carryPolReg carryValReg pol2Reg var2Reg pol2Reg var2Reg)
      (.assign remainingReg (.const 0)))

def splitTailEmitTerminalOneWriterProg
    (curJ tmpJ remainingReg carryPolReg carryValReg polReg valReg : ℕ) : Program :=
  .seq
    (writerAppendThreeRegsProg curJ tmpJ carryPolReg carryValReg polReg valReg polReg valReg)
    (.assign remainingReg (.const 0))

lemma writerState_assign_zero
    (M curJ start : ℕ) (pref : Bits) (r : ℕ) (σ : Store)
    (hs : WriterState σ M curJ start pref) (hr : r < start) (hr0 : r ≠ 0) :
    WriterState (writeReg σ r 0) M curJ start pref := by
  rcases hs with ⟨hroot, hcursor, hbits, hstart, hsafe⟩
  have hq : M + curJ ≠ r := by
    intro heq
    have hlt : r < M + curJ := by omega
    rw [heq] at hlt
    exact Nat.lt_irrefl _ hlt
  refine ⟨?_, ?_, ?_, hstart, hsafe⟩
  · rw [writeReg_diff _ r _ 0 (Ne.symm hr0)]
    exact hroot
  · rw [writeReg_diff _ r _ (M + curJ) hq]
    exact hcursor
  · apply bitsAt_of_frame σ (writeReg σ r 0) start _ hbits
    intro q hlo hhi
    rw [writeReg_diff _ r _ q (by omega)]

lemma writerState_assign_value
    (M curJ start : ℕ) (pref : Bits) (r v : ℕ) (σ : Store)
    (hs : WriterState σ M curJ start pref) (hr : r < start) (hr0 : r ≠ 0) :
    WriterState (writeReg σ r v) M curJ start pref := by
  rcases hs with ⟨hroot, hcursor, hbits, hstart, hsafe⟩
  have hq : M + curJ ≠ r := by
    intro heq
    have hlt : r < M + curJ := by omega
    rw [heq] at hlt
    exact Nat.lt_irrefl _ hlt
  refine ⟨?_, ?_, ?_, hstart, hsafe⟩
  · rw [writeReg_diff _ r _ 0 (Ne.symm hr0)]
    exact hroot
  · rw [writeReg_diff _ r _ (M + curJ) hq]
    exact hcursor
  · apply bitsAt_of_frame σ (writeReg σ r v) start _ hbits
    intro q hlo hhi
    rw [writeReg_diff _ r _ q (by omega)]

/-! Transporting a writer state through a parser which only changes its
control registers.  The explicit frame hypothesis keeps this lemma useful
for both the terminal and intermediate split-tail emitters. -/

lemma writerState_transport_of_frame4
    (M curJ start : ℕ) (pref : Bits) (σ τ : Store)
    (cursorReg polReg varReg doneReg : ℕ)
    (hs : WriterState σ M curJ start pref)
    (hframe : ∀ r, r ≠ cursorReg → r ≠ polReg → r ≠ varReg → r ≠ doneReg →
      τ r = σ r)
    (hcursor0 : cursorReg ≠ 0) (hpol0 : polReg ≠ 0)
    (hvar0 : varReg ≠ 0) (hdone0 : doneReg ≠ 0)
    (hcursor : cursorReg < start) (hpol : polReg < start)
    (hvar : varReg < start) (hdone : doneReg < start) :
    WriterState τ M curJ start pref := by
  rcases hs with ⟨hroot, hcur, hbits, hstart, hsafe⟩
  refine ⟨?_, ?_, ?_, hstart, hsafe⟩
  · rw [hframe 0 (Ne.symm hcursor0) (Ne.symm hpol0)
      (Ne.symm hvar0) (Ne.symm hdone0)]
    exact hroot
  · have htarget : M + curJ ≠ cursorReg := by omega
    have htarget' : M + curJ ≠ polReg := by omega
    have htarget'' : M + curJ ≠ varReg := by omega
    have htarget''' : M + curJ ≠ doneReg := by omega
    rw [hframe (M + curJ) htarget htarget' htarget'' htarget''']
    exact hcur
  · apply bitsAt_of_frame σ τ start pref hbits
    intro q hlo hhi
    have hqCursor : q ≠ cursorReg := by omega
    have hqPol : q ≠ polReg := by omega
    have hqVar : q ≠ varReg := by omega
    have hqDone : q ≠ doneReg := by omega
    exact hframe q hqCursor hqPol hqVar hqDone

/-! A disjoint parser/writer state.  The input window starts above the writer's
workspace/control cells, while the writer's cursor and all parser registers
remain below the input start.  This is the concrete separation invariant used
by the split-tail loop; it avoids relying on an implicit non-overlap claim. -/

structure ParserWriterDisjoint
    (σ : Store) (M curJ tmpJ start addr : ℕ) (pref bits : Bits)
    (cursorReg polReg varReg doneReg : ℕ) : Prop where
  input : BitsFrom σ addr bits
  input_above : M + tmpJ < addr
  start_at_input : start ≤ addr
  parser_below : cursorReg < start ∧ polReg < start ∧ varReg < start ∧ doneReg < start
  parser_nonzero : cursorReg ≠ 0 ∧ polReg ≠ 0 ∧ varReg ≠ 0 ∧ doneReg ≠ 0
  writer : WriterState σ M curJ start pref

lemma clauseToThree_cons4_splitTail_entry
    (base : ℕ) (l1 l2 l3 : Literal) (rest : List Literal) :
    clauseToThree base (l1 :: l2 :: l3 :: rest) =
      (⟨l1, l2, Literal.pos base⟩ ::
        (splitTail (base + 1) (Literal.neg base) (l3 :: rest)).1,
       (splitTail (base + 1) (Literal.neg base) (l3 :: rest)).2) := by
  exact clauseToThree_cons4 base l1 l2 l3 rest

structure ParserRegisterSafety (start cursor pol var done : ℕ) : Prop where
  below : cursor < start ∧ pol < start ∧ var < start ∧ done < start
  nonzero : cursor ≠ 0 ∧ pol ≠ 0 ∧ var ≠ 0 ∧ done ≠ 0
  distinct : cursor ≠ pol ∧ cursor ≠ var ∧ cursor ≠ done ∧
    pol ≠ var ∧ pol ≠ done ∧ var ≠ done

structure SplitTailRegisterSafety
    (start cursorReg polReg varReg doneReg remainingReg pol2Reg var2Reg pol3Reg var3Reg
      carryPolReg carryValReg posPolReg freshReg : ℕ) : Prop where
  main : ParserRegisterSafety start cursorReg polReg varReg doneReg
  second : ParserRegisterSafety start cursorReg pol2Reg var2Reg doneReg
  third : ParserRegisterSafety start cursorReg pol3Reg var3Reg doneReg
  cross : pol2Reg ≠ pol3Reg ∧ pol2Reg ≠ var3Reg ∧
    var2Reg ≠ pol3Reg ∧ var2Reg ≠ var3Reg
  writer_below : carryPolReg < start ∧ carryValReg < start ∧
    posPolReg < start ∧ freshReg < start ∧ remainingReg < start
  carry_pol_nonzero : carryPolReg ≠ 0
  writer_nonzero : carryValReg ≠ 0 ∧ freshReg ≠ 0
  remaining_nonzero : remainingReg ≠ 0
  writer_distinct :
    carryPolReg ≠ carryValReg ∧ carryPolReg ≠ posPolReg ∧
    carryPolReg ≠ freshReg ∧ carryPolReg ≠ remainingReg ∧
    carryValReg ≠ posPolReg ∧ carryValReg ≠ freshReg ∧
    carryValReg ≠ remainingReg ∧ posPolReg ≠ freshReg ∧
    posPolReg ≠ remainingReg ∧ freshReg ≠ remainingReg
  writer_parser : ∀ r,
    r = carryPolReg ∨ r = carryValReg ∨ r = posPolReg ∨
      r = freshReg ∨ r = remainingReg →
    r ≠ cursorReg ∧ r ≠ polReg ∧ r ≠ varReg ∧ r ≠ doneReg ∧
      r ≠ pol2Reg ∧ r ≠ var2Reg ∧ r ≠ pol3Reg ∧ r ≠ var3Reg

def splitTailInputBits (ls : List Literal) (tail : Bits) : Bits :=
  (ls.map encodeLiteral).flatten ++ tail

structure SplitTailEmitRel
    (σ : Store) (M curJ tmpJ start : ℕ)
    (base : ℕ) (carry : Literal) (ls : List Literal)
    (pref tail : Bits) (addr : ℕ)
    (cursorReg polReg varReg doneReg remainingReg pol2Reg var2Reg pol3Reg var3Reg
      carryPolReg carryValReg posPolReg freshReg : ℕ) : Prop where
  input : BitsFrom σ addr (splitTailInputBits ls tail)
  cur_j_pos : 1 ≤ curJ
  tmp_j_pos : curJ < tmpJ
  input_above : M + tmpJ < addr
  start_at_input : start ≤ addr
  writer : WriterState σ M curJ start pref
  carry_pol : σ carryPolReg = 1
  carry_one : literalPolarity carry = 1
  carry_val : σ carryValReg = carry.var
  pos : σ posPolReg = 0
  fresh : σ freshReg = base
  remaining : σ remainingReg = ls.length
  cursor : σ cursorReg = addr
  capacity : start + pref.length + (splitTailPayload base carry ls).length + 2 < M + curJ
  safety : SplitTailRegisterSafety start cursorReg polReg varReg doneReg remainingReg
    pol2Reg var2Reg pol3Reg var3Reg carryPolReg carryValReg posPolReg freshReg

structure SplitTailEmitDone
    (σ : Store) (M curJ start : ℕ) (base : ℕ) (carry : Literal)
    (ls : List Literal) (pref tail : Bits) (addr : ℕ)
    (cursorReg remainingReg freshReg : ℕ) : Prop where
  writer : WriterState σ M curJ start (pref ++ splitTailPayload base carry ls)
  remaining : σ remainingReg = 0
  cursor : σ cursorReg = addr + (splitTailInputBits ls []).length
  fresh : σ freshReg = base
  input : BitsFrom σ (addr + (splitTailInputBits ls []).length) tail

/-- A terminal split-tail endpoint together with the source-store frame needed
    by the enclosing clause emitter.  The source store is kept explicitly so
    that the high input region can be transported through the fixed loop. -/
structure SplitTailEmitDoneFrame
    (σ source : Store) (M curJ tmpJ start : ℕ) (base : ℕ) (carry : Literal)
    (ls : List Literal) (pref tail : Bits) (addr : ℕ)
    (cursorReg remainingReg freshReg posPolReg : ℕ) : Prop where
  done : SplitTailEmitDone σ M curJ start base carry ls pref tail addr
    cursorReg remainingReg freshReg
  high_frame : ∀ r, M + tmpJ < r → σ r = source r
  pos : σ posPolReg = 0

lemma splitTailEmitTerminalOneWriterProg_eval
    (M curJ tmpJ start : ℕ) (pref : Bits)
    (remainingReg carryPolReg carryValReg polReg varReg : ℕ)
    (carryPol carryVal pol val : ℕ) (σ : Store)
    (hcurJ : 1 ≤ curJ) (htmpJ : curJ < tmpJ)
    (hcarryPol : σ carryPolReg = carryPol)
    (hcarryVal : σ carryValReg = carryVal)
    (hpol : σ polReg = pol) (hval : σ varReg = val)
    (hcarryPol01 : carryPol = 0 ∨ carryPol = 1)
    (hpol01 : pol = 0 ∨ pol = 1)
    (hlowCarryVal : carryValReg < start)
    (hlowPol : polReg < start) (hlowVal : varReg < start)
    (hlowRemaining : remainingReg < start) (hremaining0 : remainingReg ≠ 0)
    (hs : WriterState σ M curJ start pref)
    (hroom : start + pref.length + carryVal + 2 * val + 6 < M + curJ) :
    WriterState
      ((splitTailEmitTerminalOneWriterProg curJ tmpJ remainingReg carryPolReg carryValReg
        polReg varReg).eval σ)
      M curJ start
      (pref ++ encodedThreeLiteralBits carryPol carryVal pol val pol val) ∧
    (splitTailEmitTerminalOneWriterProg curJ tmpJ remainingReg carryPolReg carryValReg
      polReg varReg).eval σ remainingReg = 0 := by
  have hbody := writerAppendThreeRegsProg_eval M curJ tmpJ start pref
    carryPolReg carryValReg polReg varReg polReg varReg
    carryPol carryVal pol val pol val σ hcurJ htmpJ hcarryPol hcarryVal hpol hval hpol hval
    hcarryPol01 hpol01 hpol01
    hlowCarryVal ⟨hlowPol, hlowVal⟩ ⟨hlowPol, hlowVal⟩ hs (by omega)
  let σw := (writerAppendThreeRegsProg curJ tmpJ carryPolReg carryValReg polReg varReg
    polReg varReg).eval σ
  have hbody' : WriterState σw M curJ start
      (pref ++ encodedThreeLiteralBits carryPol carryVal pol val pol val) := by
    simpa [σw, encodedThreeLiteralBits, List.append_assoc] using hbody
  have hstate := writerState_assign_zero M curJ start
    (pref ++ encodedThreeLiteralBits carryPol carryVal pol val pol val)
    remainingReg σw hbody' hlowRemaining hremaining0
  refine ⟨?_, ?_⟩
  · simpa [splitTailEmitTerminalOneWriterProg, σw, eval_assign, eval_seq, Expr.eval] using hstate
  · simp [splitTailEmitTerminalOneWriterProg, eval_assign, Expr.eval]

lemma splitTailEmitTerminalOneWriterProg_frame
    (M curJ tmpJ start : ℕ) (pref : Bits)
    (remainingReg carryPolReg carryValReg polReg varReg : ℕ)
    (carryPol carryVal pol val : ℕ) (σ : Store)
    (hcurJ : 1 ≤ curJ) (htmpJ : curJ < tmpJ)
    (hcarryPol : σ carryPolReg = carryPol)
    (hcarryVal : σ carryValReg = carryVal)
    (hpol : σ polReg = pol) (hval : σ varReg = val)
    (hcarryPol01 : carryPol = 0 ∨ carryPol = 1)
    (hpol01 : pol = 0 ∨ pol = 1)
    (hlowCarryVal : carryValReg < start)
    (hlowPol : polReg < start) (hlowVal : varReg < start)
    (hs : WriterState σ M curJ start pref)
    (hroom : start + pref.length + carryVal + 2 * val + 6 < M + curJ)
    {r : ℕ} (hr : r < start) (hrRemaining : r ≠ remainingReg) :
    (splitTailEmitTerminalOneWriterProg curJ tmpJ remainingReg carryPolReg carryValReg
      polReg varReg).eval σ r = σ r := by
  have hbody := writerAppendThreeRegsProg_frame M curJ tmpJ start pref
    carryPolReg carryValReg polReg varReg polReg varReg
    carryPol carryVal pol val pol val σ hcurJ htmpJ hcarryPol hcarryVal hpol hval hpol hval
    hcarryPol01 hpol01 hpol01
    hlowCarryVal ⟨hlowPol, hlowVal⟩ ⟨hlowPol, hlowVal⟩ hs (by omega) hr
  rw [splitTailEmitTerminalOneWriterProg, eval_seq, eval_assign, Expr.eval]
  rw [writeReg_diff _ remainingReg _ r hrRemaining]
  exact hbody

def splitTailEmitTerminalTwoWriterProg
    (curJ tmpJ remainingReg carryPolReg carryValReg pol1Reg val1Reg pol2Reg val2Reg : ℕ) : Program :=
  .seq
    (writerAppendThreeRegsProg curJ tmpJ carryPolReg carryValReg pol1Reg val1Reg pol2Reg val2Reg)
    (.assign remainingReg (.const 0))

lemma splitTailEmitTerminalTwoWriterProg_eval
    (M curJ tmpJ start : ℕ) (pref : Bits)
    (remainingReg carryPolReg carryValReg pol1Reg val1Reg pol2Reg val2Reg : ℕ)
    (carryPol carryVal pol1 val1 pol2 val2 : ℕ) (σ : Store)
    (hcurJ : 1 ≤ curJ) (htmpJ : curJ < tmpJ)
    (hcarryPol : σ carryPolReg = carryPol)
    (hcarryVal : σ carryValReg = carryVal)
    (hpol1 : σ pol1Reg = pol1) (hval1 : σ val1Reg = val1)
    (hpol2 : σ pol2Reg = pol2) (hval2 : σ val2Reg = val2)
    (hcarryPol01 : carryPol = 0 ∨ carryPol = 1)
    (hpol101 : pol1 = 0 ∨ pol1 = 1) (hpol201 : pol2 = 0 ∨ pol2 = 1)
    (hlowCarryVal : carryValReg < start)
    (hlowPol1 : pol1Reg < start) (hlowVal1 : val1Reg < start)
    (hlowPol2 : pol2Reg < start) (hlowVal2 : val2Reg < start)
    (hlowRemaining : remainingReg < start) (hremaining0 : remainingReg ≠ 0)
    (hs : WriterState σ M curJ start pref)
    (hroom : start + pref.length + carryVal + val1 + val2 + 6 < M + curJ) :
    WriterState
      ((splitTailEmitTerminalTwoWriterProg curJ tmpJ remainingReg carryPolReg carryValReg
        pol1Reg val1Reg pol2Reg val2Reg).eval σ)
      M curJ start
      (pref ++ encodedThreeLiteralBits carryPol carryVal pol1 val1 pol2 val2) ∧
    (splitTailEmitTerminalTwoWriterProg curJ tmpJ remainingReg carryPolReg carryValReg
      pol1Reg val1Reg pol2Reg val2Reg).eval σ remainingReg = 0 := by
  have hbody := writerAppendThreeRegsProg_eval M curJ tmpJ start pref
    carryPolReg carryValReg pol1Reg val1Reg pol2Reg val2Reg
    carryPol carryVal pol1 val1 pol2 val2 σ hcurJ htmpJ hcarryPol hcarryVal
    hpol1 hval1 hpol2 hval2 hcarryPol01 hpol101 hpol201
    hlowCarryVal ⟨hlowPol1, hlowVal1⟩ ⟨hlowPol2, hlowVal2⟩ hs (by omega)
  let σw := (writerAppendThreeRegsProg curJ tmpJ carryPolReg carryValReg pol1Reg val1Reg
    pol2Reg val2Reg).eval σ
  have hbody' : WriterState σw M curJ start
      (pref ++ encodedThreeLiteralBits carryPol carryVal pol1 val1 pol2 val2) := by
    simpa [σw, encodedThreeLiteralBits, List.append_assoc] using hbody
  have hstate := writerState_assign_zero M curJ start
    (pref ++ encodedThreeLiteralBits carryPol carryVal pol1 val1 pol2 val2)
    remainingReg σw hbody' hlowRemaining hremaining0
  refine ⟨?_, ?_⟩
  · simpa [splitTailEmitTerminalTwoWriterProg, σw, eval_assign, eval_seq, Expr.eval] using hstate
  · simp [splitTailEmitTerminalTwoWriterProg, eval_assign, Expr.eval]

lemma splitTailEmitTerminalTwoWriterProg_frame
    (M curJ tmpJ start : ℕ) (pref : Bits)
    (remainingReg carryPolReg carryValReg pol1Reg val1Reg pol2Reg val2Reg : ℕ)
    (carryPol carryVal pol1 val1 pol2 val2 : ℕ) (σ : Store)
    (hcurJ : 1 ≤ curJ) (htmpJ : curJ < tmpJ)
    (hcarryPol : σ carryPolReg = carryPol)
    (hcarryVal : σ carryValReg = carryVal)
    (hpol1 : σ pol1Reg = pol1) (hval1 : σ val1Reg = val1)
    (hpol2 : σ pol2Reg = pol2) (hval2 : σ val2Reg = val2)
    (hcarryPol01 : carryPol = 0 ∨ carryPol = 1)
    (hpol101 : pol1 = 0 ∨ pol1 = 1) (hpol201 : pol2 = 0 ∨ pol2 = 1)
    (hlowCarryVal : carryValReg < start)
    (hlowPol1 : pol1Reg < start) (hlowVal1 : val1Reg < start)
    (hlowPol2 : pol2Reg < start) (hlowVal2 : val2Reg < start)
    (hs : WriterState σ M curJ start pref)
    (hroom : start + pref.length + carryVal + val1 + val2 + 6 < M + curJ)
    {r : ℕ} (hr : r < start) (hrRemaining : r ≠ remainingReg) :
    (splitTailEmitTerminalTwoWriterProg curJ tmpJ remainingReg carryPolReg carryValReg
      pol1Reg val1Reg pol2Reg val2Reg).eval σ r = σ r := by
  have hbody := writerAppendThreeRegsProg_frame M curJ tmpJ start pref
    carryPolReg carryValReg pol1Reg val1Reg pol2Reg val2Reg
    carryPol carryVal pol1 val1 pol2 val2 σ hcurJ htmpJ hcarryPol hcarryVal
    hpol1 hval1 hpol2 hval2 hcarryPol01 hpol101 hpol201
    hlowCarryVal ⟨hlowPol1, hlowVal1⟩ ⟨hlowPol2, hlowVal2⟩ hs (by omega) hr
  rw [splitTailEmitTerminalTwoWriterProg, eval_seq, eval_assign, Expr.eval]
  rw [writeReg_diff _ remainingReg _ r hrRemaining]
  exact hbody

def splitTailEmitTerminalTwoProg
    (curJ tmpJ cursorReg _polReg _varReg doneReg remainingReg pol2Reg var2Reg pol3Reg var3Reg
      carryPolReg carryValReg _posPolReg _freshReg bound : ℕ) : Program :=
  .seq
    (decodeLiteralValueProgram cursorReg pol2Reg var2Reg doneReg bound)
    (.seq
      (decodeLiteralValueProgram cursorReg pol3Reg var3Reg doneReg bound)
      (.seq
        (writerAppendThreeRegsProg curJ tmpJ carryPolReg carryValReg pol2Reg var2Reg pol3Reg var3Reg)
        (.assign remainingReg (.const 0))))

lemma decode_two_literal_value_correct
    (cursorReg pol1Reg var1Reg pol2Reg var2Reg doneReg bound addr : ℕ)
    (l1 l2 : Literal) (rest : Bits) (σ : Store)
    (hcp1 : cursorReg ≠ pol1Reg) (hcv1 : cursorReg ≠ var1Reg)
    (hcd : cursorReg ≠ doneReg) (hpv1 : pol1Reg ≠ var1Reg)
    (hpd1 : pol1Reg ≠ doneReg) (hvd1 : var1Reg ≠ doneReg)
    (hcp2 : cursorReg ≠ pol2Reg) (hcv2 : cursorReg ≠ var2Reg)
    (hpv2 : pol2Reg ≠ var2Reg) (hpd2 : pol2Reg ≠ doneReg)
    (hvd2 : var2Reg ≠ doneReg)
    (hbelow : cursorReg < addr ∧ pol1Reg < addr ∧ var1Reg < addr ∧
      pol2Reg < addr ∧ var2Reg < addr ∧ doneReg < addr)
    (hbound1 : l1.var + 1 ≤ bound) (hbound2 : l2.var + 1 ≤ bound)
    (hc : σ cursorReg = addr)
    (hbits : BitsFrom σ addr (encodeLiteral l1 ++ encodeLiteral l2 ++ rest)) :
    ∃ τ υ,
      τ = (decodeLiteralValueProgram cursorReg pol1Reg var1Reg doneReg bound).eval σ ∧
      υ = (decodeLiteralValueProgram cursorReg pol2Reg var2Reg doneReg bound).eval τ ∧
      τ cursorReg = addr + l1.var + 2 ∧
      τ pol1Reg = literalPolarity l1 ∧ τ var1Reg = l1.var ∧
      υ cursorReg = addr + l1.var + 2 + l2.var + 2 ∧
      υ pol2Reg = literalPolarity l2 ∧ υ var2Reg = l2.var ∧
      (∀ r, r ≠ cursorReg → r ≠ pol1Reg → r ≠ var1Reg → r ≠ doneReg →
        τ r = σ r) ∧
      (∀ r, r ≠ cursorReg → r ≠ pol2Reg → r ≠ var2Reg → r ≠ doneReg →
        υ r = τ r) := by
  have hbits' : BitsFrom σ addr
      (encodeLiteral l1 ++ (encodeLiteral l2 ++ rest)) := by
    simpa [List.append_assoc] using hbits
  obtain ⟨hcur1, hpol1, hvar1, _, hframe1⟩ :=
    decodeLiteralValueProgram_correct cursorReg pol1Reg var1Reg doneReg bound addr l1
      (encodeLiteral l2 ++ rest) σ hcp1 hcv1 hcd hpv1 hpd1 hvd1
      (by omega) (by omega) (by omega) (by omega) hbound1 hc hbits'
  let τ := (decodeLiteralValueProgram cursorReg pol1Reg var1Reg doneReg bound).eval σ
  have htailσ : BitsFrom σ (addr + l1.var + 2)
      (encodeLiteral l2 ++ rest) := by
    obtain ⟨_, ht⟩ := bitsFrom_append σ addr (encodeLiteral l1)
      (encodeLiteral l2 ++ rest) hbits'
    have hlen : (encodeLiteral l1).length = l1.var + 2 := by
      cases l1 <;> simp [encodeLiteral, encodeNat_length, var_pos, var_neg]
    rw [hlen] at ht
    exact ht
  have htailτ : BitsFrom τ (addr + l1.var + 2)
      (encodeLiteral l2 ++ rest) := by
    intro k hk
    have hf := hframe1 (addr + l1.var + 2 + k)
      (by omega) (by omega) (by omega) (by omega)
    simpa [τ] using (hf.trans (htailσ k hk))
  obtain ⟨hcur2, hpol2, hvar2, _, hframe2⟩ :=
    decodeLiteralValueProgram_correct cursorReg pol2Reg var2Reg doneReg bound
      (addr + l1.var + 2) l2 rest τ hcp2 hcv2 hcd hpv2 hpd2 hvd2
      (by omega) (by omega) (by omega) (by omega) hbound2
      (by simpa [τ] using hcur1) htailτ
  let υ := (decodeLiteralValueProgram cursorReg pol2Reg var2Reg doneReg bound).eval τ
  have hpol1' : τ pol1Reg = literalPolarity l1 := by
    cases l1 <;> simpa [τ, literalPolarity] using hpol1
  have hpol2' : υ pol2Reg = literalPolarity l2 := by
    cases l2 <;> simpa [υ, literalPolarity] using hpol2
  refine ⟨τ, υ, rfl, rfl, hcur1, hpol1', hvar1, ?_, hpol2', hvar2, ?_, ?_⟩
  · simpa [υ] using hcur2
  · exact hframe1
  · exact hframe2

def splitTailEmitIntermediateProg
    (curJ tmpJ cursorReg polReg varReg doneReg remainingReg carryPolReg carryValReg
      posPolReg freshReg bound : ℕ) : Program :=
  .seq
    (decodeLiteralValueProgram cursorReg polReg varReg doneReg bound)
    (.seq
      (writerAppendSplitTailLinkDynamicProg curJ tmpJ carryPolReg carryValReg polReg varReg
        posPolReg freshReg)
      (.assign remainingReg (.sub (.reg remainingReg) (.const 1))))

/-- After decoding the head literal, the writer registers and remaining count keep
    their values, the decoded literal sits in `polReg`/`varReg`, and the decode
    phase leaves a writer state. -/
lemma decodeLiteralValueProgram_eval_parsed
    (M curJ start : ℕ) (pref rest : Bits)
    (cursorReg polReg varReg doneReg remainingReg : ℕ)
    (carryPolReg carryValReg posPolReg freshReg bound addr : ℕ)
    (carryPol carryVal base rem : ℕ) (l : Literal) (σ : Store)
    (hcarryPol : σ carryPolReg = carryPol)
    (hcarryVal : σ carryValReg = carryVal)
    (hpos : σ posPolReg = 0) (hfresh : σ freshReg = base)
    (hrem : σ remainingReg = rem)
    (hparserBelow : cursorReg < start ∧ polReg < start ∧
      varReg < start ∧ doneReg < start)
    (hparserNonzero : cursorReg ≠ 0 ∧ polReg ≠ 0 ∧
      varReg ≠ 0 ∧ doneReg ≠ 0)
    (hcp : cursorReg ≠ polReg) (hcv : cursorReg ≠ varReg)
    (hcd : cursorReg ≠ doneReg) (hpv : polReg ≠ varReg)
    (hpd : polReg ≠ doneReg) (hvd : varReg ≠ doneReg)
    (hwriterDisjoint : ∀ r, r = carryPolReg ∨ r = carryValReg ∨
      r = posPolReg ∨ r = freshReg ∨ r = remainingReg →
      r ≠ cursorReg ∧ r ≠ polReg ∧ r ≠ varReg ∧ r ≠ doneReg)
    (hstartAddr : start ≤ addr)
    (hbound : l.var + 1 ≤ bound)
    (hc : σ cursorReg = addr)
    (hbits : BitsFrom σ addr (encodeLiteral l ++ rest))
    (hs : WriterState σ M curJ start pref) :
    ∃ τ,
      τ = (decodeLiteralValueProgram cursorReg polReg varReg doneReg bound).eval σ ∧
      WriterState τ M curJ start pref ∧
      τ carryPolReg = carryPol ∧ τ carryValReg = carryVal ∧
      τ posPolReg = 0 ∧ τ freshReg = base ∧ τ remainingReg = rem ∧
      τ polReg = literalPolarity l ∧ τ varReg = l.var ∧
      τ cursorReg = addr + l.var + 2 := by
  obtain ⟨hcur, hpol, hvar, hdone, hdecFrame⟩ :=
    decodeLiteralValueProgram_correct cursorReg polReg varReg doneReg bound addr l rest σ
      hcp hcv hcd hpv hpd hvd
      (lt_of_lt_of_le hparserBelow.1 hstartAddr)
      (lt_of_lt_of_le hparserBelow.2.1 hstartAddr)
      (lt_of_lt_of_le hparserBelow.2.2.1 hstartAddr)
      (lt_of_lt_of_le hparserBelow.2.2.2 hstartAddr)
      hbound hc hbits
  refine ⟨_, rfl, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, hcur⟩
  · apply writerState_transport_of_frame4 M curJ start pref σ _
      cursorReg polReg varReg doneReg hs (by simpa using hdecFrame)
      hparserNonzero.1 hparserNonzero.2.1 hparserNonzero.2.2.1 hparserNonzero.2.2.2
      hparserBelow.1 hparserBelow.2.1 hparserBelow.2.2.1 hparserBelow.2.2.2
  · have hf := hdecFrame carryPolReg
      (hwriterDisjoint carryPolReg (Or.inl rfl)).1
      (hwriterDisjoint carryPolReg (Or.inl rfl)).2.1
      (hwriterDisjoint carryPolReg (Or.inl rfl)).2.2.1
      (hwriterDisjoint carryPolReg (Or.inl rfl)).2.2.2
    simpa using hf.trans hcarryPol
  · have hf := hdecFrame carryValReg
      (hwriterDisjoint carryValReg (Or.inr (Or.inl rfl))).1
      (hwriterDisjoint carryValReg (Or.inr (Or.inl rfl))).2.1
      (hwriterDisjoint carryValReg (Or.inr (Or.inl rfl))).2.2.1
      (hwriterDisjoint carryValReg (Or.inr (Or.inl rfl))).2.2.2
    simpa using hf.trans hcarryVal
  · have hf := hdecFrame posPolReg
      (hwriterDisjoint posPolReg (Or.inr (Or.inr (Or.inl rfl)))).1
      (hwriterDisjoint posPolReg (Or.inr (Or.inr (Or.inl rfl)))).2.1
      (hwriterDisjoint posPolReg (Or.inr (Or.inr (Or.inl rfl)))).2.2.1
      (hwriterDisjoint posPolReg (Or.inr (Or.inr (Or.inl rfl)))).2.2.2
    simpa using hf.trans hpos
  · have hf := hdecFrame freshReg
      (hwriterDisjoint freshReg (Or.inr (Or.inr (Or.inr (Or.inl rfl))))).1
      (hwriterDisjoint freshReg (Or.inr (Or.inr (Or.inr (Or.inl rfl))))).2.1
      (hwriterDisjoint freshReg (Or.inr (Or.inr (Or.inr (Or.inl rfl))))).2.2.1
      (hwriterDisjoint freshReg (Or.inr (Or.inr (Or.inr (Or.inl rfl))))).2.2.2
    simpa using hf.trans hfresh
  · have hf := hdecFrame remainingReg
      (hwriterDisjoint remainingReg (Or.inr (Or.inr (Or.inr (Or.inr rfl))))).1
      (hwriterDisjoint remainingReg (Or.inr (Or.inr (Or.inr (Or.inr rfl))))).2.1
      (hwriterDisjoint remainingReg (Or.inr (Or.inr (Or.inr (Or.inr rfl))))).2.2.1
      (hwriterDisjoint remainingReg (Or.inr (Or.inr (Or.inr (Or.inr rfl))))).2.2.2
    simpa using hf.trans hrem
  · cases l with
    | pos v => simpa [literalPolarity] using hpol
    | neg v => simpa [literalPolarity] using hpol
  · simpa using hvar

/-- The dynamic link leaves the cursor at the post-decode address, since it
    only writes the carry and fresh registers. -/
lemma writerAppendSplitTailLinkDynamicProg_eval_link_cursor
    (M curJ tmpJ start addr : ℕ) (pref : Bits)
    (cursorReg polReg varReg
      carryPolReg carryValReg posPolReg freshReg : ℕ)
    (carryPol carryVal base val : ℕ) (l : Literal) (τ : Store)
    (hcurJ : 1 ≤ curJ) (htmpJ : curJ < tmpJ)
    (hcarryPol : τ carryPolReg = carryPol)
    (hcarryVal : τ carryValReg = carryVal)
    (hcarryPol01 : carryPol = 0 ∨ carryPol = 1)
    (hpol01 : τ polReg = 0 ∨ τ polReg = 1)
    (hvar : τ varReg = val)
    (hpos : τ posPolReg = 0) (hfresh : τ freshReg = base)
    (hlowCarryVal : carryValReg < start)
    (hlowPol : polReg < start) (hlowVal : varReg < start)
    (hlowPos : posPolReg < start) (hlowFresh : freshReg < start)
    (hcursorBelow : cursorReg < start)
    (hcursorCarry : cursorReg ≠ carryValReg)
    (hcursorFresh : cursorReg ≠ freshReg)
    (hs : WriterState τ M curJ start pref)
    (hroom : start + pref.length + carryVal + val + base + 6 < M + curJ)
    (hτcur : τ cursorReg = addr + l.var + 2) :
    (writerAppendSplitTailLinkDynamicProg curJ tmpJ carryPolReg carryValReg
      polReg varReg posPolReg freshReg).eval τ cursorReg = addr + l.var + 2 := by
  have hbody := writerAppendThreeRegsProg_frame M curJ tmpJ start pref
    carryPolReg carryValReg polReg varReg posPolReg freshReg carryPol carryVal
    (τ polReg) val 0 base τ hcurJ htmpJ hcarryPol hcarryVal rfl hvar hpos hfresh
    hcarryPol01 hpol01 (Or.inl rfl)
    hlowCarryVal ⟨hlowPol, hlowVal⟩
    ⟨hlowPos, hlowFresh⟩ hs (by omega) hcursorBelow
  dsimp only [writerAppendSplitTailLinkDynamicProg]
  simp only [eval_seq, eval_assign, Expr.eval]
  rw [writeReg_diff _ freshReg _ cursorReg hcursorFresh]
  rw [writeReg_diff _ carryValReg _ cursorReg hcursorCarry]
  exact hbody.trans hτcur

/-- The dynamic link leaves the remaining counter unchanged. -/
lemma writerAppendSplitTailLinkDynamicProg_eval_link_remaining
    (M curJ tmpJ start : ℕ) (pref : Bits)
    (polReg varReg remainingReg
      carryPolReg carryValReg posPolReg freshReg : ℕ)
    (carryPol carryVal base val rem : ℕ) (τ : Store)
    (hcurJ : 1 ≤ curJ) (htmpJ : curJ < tmpJ)
    (hcarryPol : τ carryPolReg = carryPol)
    (hcarryVal : τ carryValReg = carryVal)
    (hcarryPol01 : carryPol = 0 ∨ carryPol = 1)
    (hpol01 : τ polReg = 0 ∨ τ polReg = 1)
    (hvar : τ varReg = val)
    (hpos : τ posPolReg = 0) (hfresh : τ freshReg = base)
    (hlowCarryVal : carryValReg < start)
    (hlowPol : polReg < start) (hlowVal : varReg < start)
    (hlowPos : posPolReg < start) (hlowFresh : freshReg < start)
    (hlowRemaining : remainingReg < start)
    (hremainingCarry : remainingReg ≠ carryValReg)
    (hremainingFresh : remainingReg ≠ freshReg)
    (hs : WriterState τ M curJ start pref)
    (hroom : start + pref.length + carryVal + val + base + 6 < M + curJ)
    (hτrem : τ remainingReg = rem) :
    (writerAppendSplitTailLinkDynamicProg curJ tmpJ carryPolReg carryValReg
      polReg varReg posPolReg freshReg).eval τ remainingReg = rem := by
  have hbody := writerAppendThreeRegsProg_frame M curJ tmpJ start pref
    carryPolReg carryValReg polReg varReg posPolReg freshReg carryPol carryVal
    (τ polReg) val 0 base τ hcurJ htmpJ hcarryPol hcarryVal rfl hvar hpos hfresh
    hcarryPol01 hpol01 (Or.inl rfl)
    hlowCarryVal ⟨hlowPol, hlowVal⟩
    ⟨hlowPos, hlowFresh⟩ hs (by omega) hlowRemaining
  dsimp [writerAppendSplitTailLinkDynamicProg]
  simp only [eval_seq, eval_assign, Expr.eval]
  rw [writeReg_diff _ freshReg _ remainingReg hremainingFresh]
  rw [writeReg_diff _ carryValReg _ remainingReg hremainingCarry]
  exact hbody.trans hτrem

lemma splitTailEmitIntermediateProg_eval
    (M curJ tmpJ start : ℕ) (pref rest : Bits)
    (cursorReg polReg varReg doneReg remainingReg : ℕ)
    (carryPolReg carryValReg posPolReg freshReg bound addr : ℕ)
    (carryPol carryVal base rem : ℕ) (l : Literal) (σ : Store)
    (hcurJ : 1 ≤ curJ) (htmpJ : curJ < tmpJ)
    (hcarryPol : σ carryPolReg = carryPol)
    (hcarryVal : σ carryValReg = carryVal)
    (hpos : σ posPolReg = 0) (hfresh : σ freshReg = base)
    (hrem : σ remainingReg = rem)
    (hcarryPol01 : carryPol = 0 ∨ carryPol = 1)
    (hlowCarryVal : carryValReg < start)
    (hlowPos : posPolReg < start) (hlowFresh : freshReg < start)
    (hlowRemaining : remainingReg < start)
    (hremaining0 : remainingReg ≠ 0)
    (hremainingCarry : remainingReg ≠ carryValReg)
    (hremainingFresh : remainingReg ≠ freshReg)
    (hcarryVal0 : carryValReg ≠ 0) (hfresh0 : freshReg ≠ 0)
    (hcarryFresh : carryValReg ≠ freshReg)
    (hparserBelow : cursorReg < start ∧ polReg < start ∧
      varReg < start ∧ doneReg < start)
    (hparserNonzero : cursorReg ≠ 0 ∧ polReg ≠ 0 ∧
      varReg ≠ 0 ∧ doneReg ≠ 0)
    (hcp : cursorReg ≠ polReg) (hcv : cursorReg ≠ varReg)
    (hcd : cursorReg ≠ doneReg) (hpv : polReg ≠ varReg)
    (hpd : polReg ≠ doneReg) (hvd : varReg ≠ doneReg)
    (hwriterDisjoint : ∀ r, r = carryPolReg ∨ r = carryValReg ∨
      r = posPolReg ∨ r = freshReg ∨ r = remainingReg →
      r ≠ cursorReg ∧ r ≠ polReg ∧ r ≠ varReg ∧ r ≠ doneReg)
    (hstartAddr : start ≤ addr) (hbound : l.var + 1 ≤ bound)
    (hc : σ cursorReg = addr)
    (hbits : BitsFrom σ addr (encodeLiteral l ++ rest))
    (hs : WriterState σ M curJ start pref)
    (hroom : start + pref.length + carryVal + l.var + base + 8 < M + curJ) :
    WriterState
      ((splitTailEmitIntermediateProg curJ tmpJ cursorReg polReg varReg doneReg
        remainingReg carryPolReg carryValReg posPolReg freshReg bound).eval σ)
      M curJ start
      (pref ++ encodedThreeLiteralBits carryPol carryVal (literalPolarity l) l.var 0 base) ∧
    (splitTailEmitIntermediateProg curJ tmpJ cursorReg polReg varReg doneReg
      remainingReg carryPolReg carryValReg posPolReg freshReg bound).eval σ remainingReg = rem - 1 ∧
    (splitTailEmitIntermediateProg curJ tmpJ cursorReg polReg varReg doneReg
      remainingReg carryPolReg carryValReg posPolReg freshReg bound).eval σ carryValReg = base ∧
    (splitTailEmitIntermediateProg curJ tmpJ cursorReg polReg varReg doneReg
      remainingReg carryPolReg carryValReg posPolReg freshReg bound).eval σ freshReg = base + 1 ∧
    (splitTailEmitIntermediateProg curJ tmpJ cursorReg polReg varReg doneReg
      remainingReg carryPolReg carryValReg posPolReg freshReg bound).eval σ cursorReg =
        addr + l.var + 2 := by
  obtain ⟨τ, hτ, hτstate, hτcarryPol, hτcarryVal, hτpos, hτfresh, hτrem, hτpol, hτvar, hτcur⟩ :=
    decodeLiteralValueProgram_eval_parsed M curJ start pref rest
      cursorReg polReg varReg doneReg remainingReg
      carryPolReg carryValReg posPolReg freshReg bound addr
      carryPol carryVal base rem l σ
      hcarryPol hcarryVal hpos hfresh hrem
      hparserBelow hparserNonzero
      hcp hcv hcd hpv hpd hvd hwriterDisjoint
      hstartAddr hbound hc hbits hs
  have hpol01 : τ polReg = 0 ∨ τ polReg = 1 := by
    rw [hτpol]; cases l <;> simp [literalPolarity]
  have hlinkRem := writerAppendSplitTailLinkDynamicProg_eval_link_remaining M curJ tmpJ start pref
    polReg varReg remainingReg carryPolReg carryValReg posPolReg freshReg
    carryPol carryVal base l.var rem τ hcurJ htmpJ hτcarryPol hτcarryVal hcarryPol01 hpol01
    hτvar hτpos hτfresh hlowCarryVal hparserBelow.2.1 hparserBelow.2.2.1
    hlowPos hlowFresh hlowRemaining hremainingCarry hremainingFresh hτstate (by omega) hτrem
  obtain ⟨τw, hτwdef⟩ : ∃ x, x = (writerAppendSplitTailLinkDynamicProg curJ tmpJ
    carryPolReg carryValReg polReg varReg posPolReg freshReg).eval τ := ⟨_, rfl⟩
  have hτwrem : τw remainingReg = rem := by
    rw [hτwdef]
    exact hlinkRem
  have hcursorCarry : cursorReg ≠ carryValReg :=
    (hwriterDisjoint carryValReg (Or.inr (Or.inl rfl))).1.symm
  have hcursorFresh : cursorReg ≠ freshReg :=
    (hwriterDisjoint freshReg (Or.inr (Or.inr (Or.inr (Or.inl rfl))))).1.symm
  have hτwcur : τw cursorReg = addr + l.var + 2 := by
    rw [hτwdef]
    exact writerAppendSplitTailLinkDynamicProg_eval_link_cursor M curJ tmpJ start addr pref
      cursorReg polReg varReg carryPolReg carryValReg posPolReg freshReg
      carryPol carryVal base l.var l τ hcurJ htmpJ hτcarryPol hτcarryVal hcarryPol01 hpol01
      hτvar hτpos hτfresh hlowCarryVal hparserBelow.2.1 hparserBelow.2.2.1
      hlowPos hlowFresh hparserBelow.1 hcursorCarry hcursorFresh hτstate (by omega) hτcur
  have hw : WriterState τw M curJ start
      (pref ++ encodedThreeLiteralBits carryPol carryVal (τ polReg) l.var 0 base) ∧
      τw carryValReg = base ∧ τw freshReg = base + 1 := by
    have hw := writerAppendSplitTailLinkDynamicProg_eval M curJ tmpJ start pref
      carryPolReg carryValReg polReg varReg posPolReg freshReg
      carryPol carryVal l.var base τ hcurJ htmpJ hτcarryPol hτcarryVal hpol01 hτvar
      hτpos hτfresh hcarryPol01 hlowCarryVal hparserBelow.2.1
      hparserBelow.2.2.1 hlowPos hlowFresh hcarryVal0 hfresh0 hcarryFresh
      hτstate (by omega)
    rw [hτwdef]
    exact ⟨hw.1, hw.2.1, hw.2.2⟩
  have hstate := writerState_assign_value M curJ start
    (pref ++ encodedThreeLiteralBits carryPol carryVal (τ polReg) l.var 0 base)
    remainingReg (rem - 1) τw hw.1 hlowRemaining hremaining0
  have hstate' : WriterState (writeReg τw remainingReg (rem - 1)) M curJ start
      (pref ++ encodedThreeLiteralBits carryPol carryVal (literalPolarity l) l.var 0 base) := by
    simpa [hτpol] using hstate
  have hremOut : writeReg τw remainingReg (rem - 1) remainingReg = rem - 1 := by
    simp only [writeReg_same]
  have hcarryOut : writeReg τw remainingReg (rem - 1) carryValReg = base := by
    rw [writeReg_diff _ remainingReg _ carryValReg hremainingCarry.symm]
    exact hw.2.1
  have hfreshOut : writeReg τw remainingReg (rem - 1) freshReg = base + 1 := by
    rw [writeReg_diff _ remainingReg _ freshReg hremainingFresh.symm]
    exact hw.2.2
  have hcursorOut : writeReg τw remainingReg (rem - 1) cursorReg = addr + l.var + 2 := by
    rw [writeReg_diff _ remainingReg _ cursorReg
      (hwriterDisjoint remainingReg (Or.inr (Or.inr (Or.inr (Or.inr rfl))))).1.symm]
    exact hτwcur
  rw [splitTailEmitIntermediateProg, eval_seq, eval_seq, eval_assign, Expr.eval]
  rw [← hτ, ← hτwdef]
  simp only [Expr.eval, hτwrem]
  exact ⟨hstate', hremOut, hcarryOut, hfreshOut, hcursorOut⟩

end NPComplete.CookLevin
